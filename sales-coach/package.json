{
  "name": "tonlita-sales-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "node scripts/static-audit.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "cf:dev": "wrangler pages dev dist --compatibility-date=2026-06-24",
    "db:migrate:local": "wrangler d1 migrations apply tonlita_sales_coach --local",
    "db:migrate:remote": "wrangler d1 migrations apply tonlita_sales_coach --remote",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^6.0.0",
    "typescript": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.1",
    "wrangler": "^3.99.0",
    "@cloudflare/workers-types": "^4.20250624.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
